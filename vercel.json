{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/youtube-clone/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.agents/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.agent/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.md)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.csv)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.docx)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.pdf)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.py)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.sh)",
      "destination": "/",
      "permanent": false
    }
  ]
}